{
  "expo": {
    "name": "PhiloWeek",
    "slug": "philoweek-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "philoweek",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.philoweek.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
